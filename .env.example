APP_NAME=webhook-manager
DEBUG=false

# Keep these in sync with `.env` keys.
DATABASE_URL=postgresql+asyncpg://webhook_manager:webhook_manager@postgres:5432/webhook_manager
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

SECRET_KEY=your-secret-key-minimum-32-characters-here
LOG_LEVEL=INFO

RATE_LIMIT_INGEST=100
RATE_LIMIT_READ=1000
MAX_DELIVERY_ATTEMPTS=5
DELIVERY_TIMEOUT_SECONDS=10

SENTRY_DSN=

# Platform clients are opt-in; bot registry/API is implemented in the next step.
PLATFORM_BOTS_ENABLED=false
AUTHFORTRESS_BASE_URL=http://auth_service:8000
# Generate and retain a Fernet key separately from database backups.
BOT_CREDENTIALS_KEY=
# Independent random ASCII keys, at least 32 bytes each; do not reuse SECRET_KEY.
AUTHFORTRESS_WEBHOOK_SERVICE_KEY=
WEBHOOK_AGENT_CONTEXT_KEY=
RATE_LIMIT_BOT_REGISTER=10

